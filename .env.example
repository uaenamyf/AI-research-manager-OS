# ============================================================
# ResearchOS AI - 环境变量模板
# 使用方法：复制为 .env 并修改对应值
# ============================================================

# ────────────────────────────────────────────────────────────
# 数据库配置
# ────────────────────────────────────────────────────────────
POSTGRES_DB=researchos
POSTGRES_USER=researchos
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432

# ────────────────────────────────────────────────────────────
# Redis 配置
# ────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ────────────────────────────────────────────────────────────
# RabbitMQ 配置
# ────────────────────────────────────────────────────────────
RABBIT_USER=guest
RABBIT_PASS=guest
RABBIT_PORT=5672
RABBIT_MGMT_PORT=15672

# ────────────────────────────────────────────────────────────
# JWT 安全配置（生产环境必须修改！）
# ────────────────────────────────────────────────────────────
# 生成：openssl rand -base64 32
JWT_SECRET=dGhpcy1pcy1hLWRldi1zZWNyZXQta2V5LWRvLW5vdC11c2UtaW4tcHJvZHVjdGlvbi1lbnZpcm9ubWVudA==

# ────────────────────────────────────────────────────────────
# 内部服务通信 Token（backend <-> ai-service）
# ────────────────────────────────────────────────────────────
INTERNAL_TOKEN=dev-internal-token-change-in-production

# ────────────────────────────────────────────────────────────
# CORS 配置（前端域名）
# ────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ────────────────────────────────────────────────────────────
# 前端 API 地址
# ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE=http://localhost:8080

# ────────────────────────────────────────────────────────────
# 对象存储（S3/R2）配置
# ────────────────────────────────────────────────────────────
STORAGE_TYPE=s3
STORAGE_BUCKET=researchos-pdfs
STORAGE_REGION=us-east-1
STORAGE_KEY=your-access-key
STORAGE_SECRET=your-secret-key
STORAGE_ENDPOINT=  # Cloudflare R2 需要填，S3 留空

# ────────────────────────────────────────────────────────────
# LLM 配置
# ────────────────────────────────────────────────────────────
LLM_PROVIDER=volcengine  # openai | anthropic | volcengine
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# 火山引擎（豆包）
VOLC_ACCESSKEY=your-access-key
VOLC_SECRETKEY=your-secret-key
VOLC_REGION=cn-beijing

# ────────────────────────────────────────────────────────────
# Google OAuth 配置
# ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ────────────────────────────────────────────────────────────
# Stripe 配置（商业化）
# ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_...
STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_WEBHOOK_SECRET=whsec_...
