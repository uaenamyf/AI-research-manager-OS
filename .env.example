# ============================================================
# ResearchOS AI - 环境变量模板
# 使用方法：复制为 .env 并修改对应值
# 说明：零数据库依赖 —— MySQL/PostgreSQL 已全部替换为 SQLite
#       （node:sqlite，随应用自动创建于 ~/.researchos/data/researchos.db），
#       无需安装任何数据库或 Docker，clone 后填入 LLM key 即可运行。
#       AI 管道（解析/嵌入/卡片/综述）内置于 DSH research-ai-worker。
# ============================================================

# ────────────────────────────────────────────────────────────
# 数据目录（SQLite 数据库 + 上传 PDF）
# ────────────────────────────────────────────────────────────
# 数据库文件：$RESEARCH_DATA_DIR/researchos.db（默认 ~/.researchos/data/researchos.db）
# 上传的 PDF：$RESEARCH_STORAGE_LOCAL_DIR（默认 ~/.researchos/uploads）
# 两者均在首次启动时自动创建，无需手动初始化。
# RESEARCH_DATA_DIR=
# RESEARCH_STORAGE_LOCAL_DIR=

# ────────────────────────────────────────────────────────────
# JWT 安全配置（生产环境必须修改！）
# ────────────────────────────────────────────────────────────
# 生成：openssl rand -base64 32
JWT_SECRET=dGhpcy1pcy1hLWRldi1zZWNyZXQta2V5LWRvLW5vdC11c2UtaW4tcHJvZHVjdGlvbi1lbnZpcm9ubWVudA==

# ────────────────────────────────────────────────────────────
# 内部服务通信 Token（bundle 内部调用 / 网关鉴权）
# ────────────────────────────────────────────────────────────
INTERNAL_TOKEN=dev-internal-token-change-in-production

# ────────────────────────────────────────────────────────────
# CORS 配置（前端域名）
# ────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3080

# ────────────────────────────────────────────────────────────
# LLM 配置（DSH 统一网关 research-llm-gateway 经 dsh-gateway.sh 注入）
# ────────────────────────────────────────────────────────────
# 上游真实 LLM 端点（OpenAI 兼容）；网关将其收口为本地 /v1/chat/completions
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=             # 国内网络走火山引擎/DeepSeek 等 OpenAI 兼容端点时填写
OPENAI_DEFAULT_MODEL=        # 兼容端点时为接入点 ID（如 ark-code-latest）

# 网关上游（优先于 OPENAI_BASE_URL，避免网关自环）
RESEARCH_LLM_UPSTREAM_BASE_URL=

# 嵌入模型（论文向量化）
EMBEDDING_MODEL=doubao-embedding-vision
EMBEDDING_DIM=2048           # 须与嵌入模型输出维度一致（存于 SQLite BLOB）

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# 火山引擎（豆包）
VOLC_ACCESSKEY=your-access-key
VOLC_SECRETKEY=your-secret-key
VOLC_REGION=cn-beijing

# ────────────────────────────────────────────────────────────
# Google OAuth 配置
# ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ────────────────────────────────────────────────────────────
# Stripe 配置（商业化）
# ────────────────────────────────────────────────────────────
# 1. Stripe Dashboard -> Developers -> API keys 获取
STRIPE_SECRET_KEY=sk_...
STRIPE_PUBLISHABLE_KEY=pk_...
# 2. 用 CLI 创建 webhook（本地调试）：
#    stripe listen --forward-to localhost:3080/research-subscription/webhook
# 3. 为 PRO / RESEARCHER 档位各创建一个订阅 Price，填入 price id
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_RESEARCHER=price_...

# ────────────────────────────────────────────────────────────
# 额度校验开关
# ────────────────────────────────────────────────────────────
# 是否启用上传/解析额度校验（开发默认关闭）
ENFORCE_QUOTA=false

# ────────────────────────────────────────────────────────────
# AI 管道模式（research-paper/review 直调 research-ai-worker）
# ────────────────────────────────────────────────────────────
# 1 = inline 直调（无 RabbitMQ，legacy 下线后默认）；0 = 走 MQ（需恢复 RabbitMQ）
RESEARCH_AI_INLINE=1

# ────────────────────────────────────────────────────────────
# 研究区无登录 UI 的静默引导（dev-only）
# ────────────────────────────────────────────────────────────
RESEARCH_ANON_ENABLED=1
RESEARCH_ANON_EMAIL=anon@researchos.local
RESEARCH_ANON_USER_ID=00000000-0000-0000-0000-000000000000
