# ResearchOS AI - 环境变量示例
#
# 使用方法：
#   cp .env.example .env
#   # 修改 .env 中的值（尤其是密钥）
#
# 说明：
# - .env 文件已被 .gitignore 忽略，不会入库
# - 仅 infra/docker-compose.yml 会自动读取本文件
# - 各服务还有自己的环境变量配置：
#     backend  -> backend/src/main/resources/application.yml
#     ai-service -> ai-service/.env（待创建）
#     frontend -> frontend/.env.local（待创建）

# ────────────────────────────────────────────────────────────
# 基础设施（PostgreSQL / Redis / RabbitMQ）
# ────────────────────────────────────────────────────────────
POSTGRES_DB=researchos
POSTGRES_USER=researchos
POSTGRES_PASSWORD=researchos
POSTGRES_PORT=5432

REDIS_PORT=6379

RABBIT_USER=guest
RABBIT_PASS=guest
RABBIT_PORT=5672
RABBIT_MGMT_PORT=15672

# ────────────────────────────────────────────────────────────
# 应用层（backend <-> ai-service 共享）
# ────────────────────────────────────────────────────────────
# backend 与 ai-service 之间互相校验的共享密钥，两端必须一致
INTERNAL_TOKEN=dev-internal-token

# JWT 签名密钥（base64 编码字符串，生产环境务必更换）
# 生成方式：openssl rand -base64 48
JWT_SECRET=dGhpcy1pcy1hLWRldi1zZWNyZXQta2V5LWRvLW5vdC11c2UtaW4tcHJvZHVjdGlvbi1lbnZpcm9ubWVudA==

# ────────────────────────────────────────────────────────────
# 对象存储（S3 / Cloudflare R2）
# ────────────────────────────────────────────────────────────
# type=s3 使用 AWS S3；type=r2 使用 Cloudflare R2（兼容 S3 API）
STORAGE_TYPE=s3
STORAGE_BUCKET=researchos-pdfs
STORAGE_REGION=us-east-1
STORAGE_KEY=
STORAGE_SECRET=
# R2 用户填 R2 endpoint；S3 用户留空
STORAGE_ENDPOINT=

# ────────────────────────────────────────────────────────────
# OAuth（Google 登录，Sprint 1.4 待实现）
# ────────────────────────────────────────────────────────────
# 从 Google Cloud Console -> APIs & Services -> Credentials 获取
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ────────────────────────────────────────────────────────────
# AI 服务
# ────────────────────────────────────────────────────────────
# LLM provider：openai | anthropic
LLM_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 根据选择的 LLM_PROVIDER 填写对应密钥
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ────────────────────────────────────────────────────────────
# 前端
# ────────────────────────────────────────────────────────────
# 浏览器访问的 backend 地址（开发期用 localhost，部署时改实际域名）
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE=http://localhost:8080

# ────────────────────────────────────────────────────────────
# CORS
# ────────────────────────────────────────────────────────────
# 允许的前端来源，逗号分隔多域名
CORS_ORIGINS=http://localhost:3000
