.env
.env.local
.env.*.local
**/.env
!**/.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
.next/
.eslintcache

# 临时编译文件
pgvector-build/
*.zip

# Maven 编译产物
backend/target/

# 本地存储（local 模式上传目录）
backend/uploads/

