# ── 通用规则 ──
# 环境变量（含密钥，禁止入库）
.env
.env.local
.env.*.local
**/.env
**/.env.*
!**/.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
.next/
.eslintcache

# 临时编译文件
pgvector-build/
*.zip

# Maven 编译产物
backend/target/

# 本地存储（local 模式上传目录）
backend/uploads/

# 本地测试论文样本（端到端测试用，不入库）
test_paper/

# 本地工具链（Maven/Redis 等）
tools/

# Claude skills（第三方 skill 仓库，不入库）
.claude/skills/

# Claude 对话缓存
.claude/cache/
.claude/data/
*.log

# ── DeepSeek Harness 集成（Phase 0+）──
# DSH 完整 checkout（已改造，整体入库；node_modules / lib / dist 等构建产物由
# deepseek-harness-master/.gitignore 自身规则过滤，绝不入库）
deepseek-harness-master/**/node_modules/
# dsh 常驻进程运行时产物（PID/日志，随启停变化，位于仓库根）
.dsh-gateway.pid
.dsh-gateway.log

# SQLite 数据文件（默认位于 ~/.researchos/data；若覆盖 RESEARCH_DATA_DIR
# 到仓库内则避免误提交）
researchos.db
*.db.bak-*

# 已废弃：单一仓库为 uaenamyf/dsh-researchOS（fork），本目录不再跟踪
# （原 submodule 已解绑，目录保留为工作副本）
deepseek-harness-master/
